# --- Context.dev (server-side only; never exposed to the browser) ----------
# Needed only for live monitoring. Without it the dashboard, analytics and replay all work.
CONTEXT_DEV_API_KEY=

# Local cap on credits Delta may spend (tracked in SQLite). Default 300.
CONTEXT_DEV_CREDIT_BUDGET=300

# Monitor delivery: poll (default, private: no public URL needed) or webhook.
MONITOR_MODE=poll
POLL_INTERVAL_MS=60000

# Webhook mode only: public https URL that forwards to this app, e.g.
#   cloudflared tunnel --url http://127.0.0.1:3100
PUBLIC_BASE_URL=

# Optional: SQLite location (default ./data/shelfintel.db)
SHELFINTEL_DB=
# Set to 1 to allow the dashboard through a public tunnel (default: only the webhook route)
ALLOW_REMOTE_APP=

# Daily refresh of the whole dataset (scripts/daily-sweep.ts), started by the app server at this local time.
# A full sweep costs about 3,400 credits; DAILY_SWEEP_LIMIT=N reads only the first N stores per chain.
# DAILY_SWEEP_AT=06:00
# DAILY_SWEEP_LIMIT=15

# Ask delta. chat (server-side only). Without a key the /ask page reports that the assistant is not configured.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
